# =====================================================================
#  Scalping Bot — environment template. Copy to `.env` and fill in.
#  Never commit `.env`. Live mode requires explicit, audited override.
# =====================================================================

# --- Mode -------------------------------------------------------------
TRADING_MODE=paper                     # paper | live | backtest
ENV=dev                                # dev | staging | prod
LOG_LEVEL=INFO

# --- Interactive Brokers ---------------------------------------------
# IB Gateway: 4002 paper / 4001 live   |   TWS: 7497 paper / 7496 live
IB_HOST=ib-gateway
IB_PORT=4002
IB_CLIENT_ID=17
IB_ACCOUNT=                            # optional; auto-resolved if blank
IB_READONLY=false
IB_CONNECT_TIMEOUT=15
IB_RECONNECT_DELAY=5

# --- Database ---------------------------------------------------------
POSTGRES_USER=scalper
POSTGRES_PASSWORD=scalper
POSTGRES_DB=scalper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scalper:scalper@postgres:5432/scalper

# --- Redis ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Telegram ---------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_SECRET_KEY=change-me-please

# --- Market filters (defaults; tunable via /settings) ----------------
FILTER_MIN_PRICE=2.0
FILTER_MAX_PRICE=20.0
FILTER_MIN_DAILY_VOLUME=1000000
FILTER_MIN_RVOL=2.0
FILTER_MAX_FLOAT=50000000
FILTER_MAX_SPREAD_BPS=50

# --- Risk defaults ----------------------------------------------------
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_LOSS_PER_TRADE_PCT=0.5
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_ACCOUNT_EXPOSURE_PCT=50.0
RISK_DEFAULT_STOP_ATR_MULT=1.5
RISK_DEFAULT_TARGET_R=2.0
RISK_TRAIL_AFTER_R=1.0
RISK_TRAIL_ATR_MULT=1.0
RISK_COOLDOWN_AFTER_LOSS_SEC=300
RISK_CIRCUIT_BREAKER_LOSSES=3

# --- Scanner ----------------------------------------------------------
SCANNER_INTERVAL_SEC=5
SCANNER_UNIVERSE_SIZE=400
